# このファイルを .env にコピーして使う
DB_FILE_NAME=file:local.db
# better-auth の秘密鍵（32文字以上のランダムな文字列。openssl rand -base64 32 などで作る）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
# フロントの URL（カンマ区切りで複数可）
WEB_ORIGIN=http://localhost:3000
# 飼育員登録用の招待コード
KEEPER_INVITE_CODE=ZOO-KEEPER-2026
# 動物園の緯度・経度（Open-Meteo 用）
ZOO_LATITUDE=35.7165
ZOO_LONGITUDE=139.7714
